    {"id": "depA", "type": "depart", "col": "depA", "rang": "g1", "taille": 15, "texte": "Éclair blanc, détonation", "source": "§2"},
    {"id": "depB", "type": "depart", "col": "depB", "rang": "g1", "taille": 15, "texte": "Alerte nucléaire, sans éclair", "source": "§2 ; étape 4"},
    {"id": "q1", "type": "question", "col": "q1", "rang": "g2", "texte": "Où est-on ?"},
    {"id": "dedans", "type": "urgent", "col": "v1", "rang": "g3", "ancre": "haut", "taille": 10.5, "temps": "30 s", "texte": "**S'éloigner des fenêtres** et se coucher à couvert jusqu'au souffle.", "renvoi": "ch. 4, étape 1", "source": "étape 1"},
    {"id": "dehors", "type": "urgent", "col": "v2", "rang": "g3", "ancre": "haut", "taille": 10.5, "temps": "30 s", "texte": "**À plat ventre**, visage au sol, mains sous le corps, jusqu'au souffle.", "renvoi": "ch. 4, étape 2", "source": "étape 2"},
    {"id": "auto", "type": "urgent", "col": "v3", "rang": "g3", "ancre": "haut", "taille": 10.5, "temps": "30 s", "texte": "**Freiner, s'arrêter**, se baisser sous les vitres jusqu'au souffle.", "renvoi": "ch. 4, étape 3", "source": "étape 3"},
    {"id": "entrer", "type": "urgent", "col": "large", "rang": "g4", "ancre": "haut", "temps": "10 min", "texte": "**Entrer dans le bâtiment le plus solide qu'on atteint en quelques minutes** : sous-sol, béton, brique. Ceux qui étaient dehors laissent à la porte la couche du dessus et les chaussures.", "renvoi": "ch. 4, étapes 4 et 5", "source": "étapes 4 et 5"},
    {"id": "famille", "type": "question", "col": "tronc", "rang": "g5", "texte": "Toute la famille est là ?"},
    {"id": "absent", "type": "urgent", "col": "cote", "rang": "g5", "texte": "**Ne ressortir chercher personne**, même à l'école : on se retrouve après l'abri.", "renvoi": "ch. 4, étape 6", "source": "étape 6"},
    {"id": "fermer", "type": "urgent", "col": "large", "rang": "g6", "ancre": "haut", "texte": "**Rentrer les animaux, fermer portes et fenêtres**, arrêter fournaise, échangeur d'air et climatiseur.", "renvoi": "ch. 4, étapes 6 et 7", "source": "étapes 6 et 7"},
    {"id": "ou", "type": "question", "col": "tronc", "rang": "g7", "texte": "Où s'abriter ?"},
    {"id": "sous-sol", "type": "urgent", "col": "v1", "rang": "g8", "ancre": "haut", "taille": 10.5, "texte": "**Descendre**, contre un mur enterré.", "renvoi": "ch. 4, étape 8 ; ch. 79", "source": "étape 8"},
    {"id": "changer", "type": "urgent", "col": "v2", "rang": "g8", "ancre": "haut", "taille": 10.5, "texte": "**Y aller**, et y être au plus tard 30 min après l'éclair.", "renvoi": "ch. 4, étape 9", "source": "étape 9"},
    {"id": "centre", "type": "urgent", "col": "v3", "rang": "g8", "ancre": "haut", "taille": 10.5, "texte": "**Centre de la maison**, loin du toit ; empiler la masse.", "renvoi": "ch. 4, étape 8 et §9", "source": "étape 8 ; §9"},
    {"id": "laver", "type": "urgent", "col": "tronc2", "rang": "d1", "ancre": "haut", "temps": "1 h", "texte": "**Se laver** à l'eau et au savon, sans revitalisant ; sans eau, au linge mouillé.", "renvoi": "ch. 4, étape 10", "source": "étape 10"},
    {"id": "radio", "type": "urgent", "col": "tronc2", "rang": "d2", "ancre": "haut", "texte": "**Ouvrir la radio** qu'on a, à piles ou à manivelle. Noter l'heure sur le cadre de porte.", "renvoi": "ch. 4, étape 11", "source": "étape 11"},
    {"id": "ki", "type": "question", "col": "tronc2", "rang": "d3", "texte": "Des comprimés d'iode (KI) ?"},
    {"id": "q24", "type": "question", "col": "tronc2", "rang": "d4", "texte": "Moins de 24 h depuis l'exposition ?"},
    {"id": "pas-iode", "type": "geste", "col": "cote2", "rang": "d4", "texte": "**Aucun autre iode ne protège** : ni teinture, ni Bétadine, ni sel iodé. Couper lait frais, légumes-feuilles et eau de surface 6 à 8 semaines.", "renvoi": "ch. 4, §8 et §9", "source": "§8, point 1 ; §9, sans comprimés d'iode ; étape 13"},
    {"id": "dose", "type": "urgent", "col": "tronc2", "rang": "d5", "ancre": "haut", "texte": "**Donner la dose par âge**, enfants d'abord, le plus tôt possible.", "renvoi": "ch. 4, étapes 12 à 14", "source": "étapes 12 à 14"},
    {"id": "abri", "type": "geste", "col": "tronc2", "rang": "d6", "ancre": "haut", "texte": "**Pendant l'abri** : boucher les courants d'air, manger ce qui était fermé, boire la réserve.", "renvoi": "ch. 4, étapes 15 à 18", "source": "étapes 15 à 18"},
    {"id": "co", "type": "danger", "col": "cote2", "rang": "dco", "ancre": "haut", "titre": "Aux 6 h : l'avertisseur de CO", "texte": "**Alarme, mal de tête ou somnolence chez plusieurs : ouvrir, sortir tout le monde.** Ces signes ressemblent à ceux d'une irradiation. Génératrice : jamais dans un bâtiment, un garage ou sous un auvent.", "renvoi": "ch. 4, §8", "source": "§6 ; §7 ; §8, point 3"},
    {"id": "h24", "type": "question", "col": "tronc2", "rang": "d7", "ancre": "haut", "temps": "24 h", "texte": "Des nouvelles à la radio, et le débit en baisse ?", "precision": "À l'électroscope, si on en a un", "source": "étape 20"},
    {"id": "48h", "type": "geste", "col": "cote2", "rang": "d7", "ancre": "haut", "temps": "48 h", "texte": "**Rester jusqu'à 48 h.** Sans radio : 48 h strictes, puis sorties courtes deux semaines.", "renvoi": "ch. 4, étape 20 et §9", "source": "étape 20 ; §9"},
    {"id": "sortir", "type": "geste", "col": "tronc2", "rang": "d8", "ancre": "haut", "texte": "**Déboucher, ensacher les filtres de la fournaise**, puis sorties courtes.", "renvoi": "ch. 4, étape 21", "source": "étape 21"},
    {"id": "fin-maison", "type": "geste", "x": [9.05, 11.95], "rang": "d9", "ancre": "haut", "texte": "**Rester ou partir** : reprendre la décision à heure fixe.", "renvoi": "ch. 2", "source": "ch. 2, étape 10"},
    {"id": "fin-chalet", "type": "geste", "col": "cote2", "rang": "d9", "ancre": "haut", "texte": "**Trier ce qui se mange**, pour des années.", "renvoi": "ch. 4, étapes 24 à 28", "source": "étapes 24 à 28"}
